# ================================================
# NOTCARE API - CONFIGURAÇÕES DE AMBIENTE
# ================================================
# Copie este arquivo para .env e preencha com seus valores reais
# ⚠️ NUNCA compartilhe o arquivo .env em repositórios!

# ================================================
# SERVIDOR
# ================================================
PORT=5000
NODE_ENV=development

# ================================================
# BANCO DE DADOS
# ================================================
# SQLite irá criar o arquivo notcare.db automaticamente
DATABASE_PATH=./notcare.db

# ================================================
# JWT (Autenticação)
# ================================================
# Gere uma chave secreta forte
JWT_SECRET=notcare_secret_key_change_this_in_production_2024

# ================================================
# EMAIL (Para envIO de OTP de 2FA)
# ================================================
# Para Gmail, use uma Senha de App específica
# Veja: https://support.google.com/accounts/answer/185833
EMAIL_SERVICE=gmail
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui

# ================================================
# FRONTEND
# ================================================
# URL do frontend para CORS
FRONTEND_URL=http://localhost:3000

# ================================================
# OPCIONAL
# ================================================
# Ativar modo desenvolvimento sem envio de e-mail (rede local)
DEV_BYPASS_MFA=true
# LOG_LEVEL=info
# DATABASE_RESET=false
